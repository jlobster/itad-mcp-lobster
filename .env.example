ITAD_API_KEY=your_isthereanydeal_api_key
ITAD_OAUTH_TOKEN=your_oauth_token

# Optional: register the 8 /internal/* tools (off by default).
# ITAD documents these as "available only for our own services"; see README "Internal endpoints".
# ITAD_ENABLE_INTERNAL_TOOLS=true

# Optional: per-request timeout for calls to ITAD, in milliseconds (default 30000).
# ITAD_REQUEST_TIMEOUT_MS=30000
